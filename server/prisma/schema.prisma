// EventHub Prisma schema — MongoDB connector.
//
// MongoDB notes for maintainers:
//   * Prisma's MongoDB connector has no enums, so every status/role field is a
//     plain `String` constrained by a zod schema in the API layer. The accepted
//     values are mirrored as `Object.freeze` constants in `dist/src`.
//   * `_id` is an ObjectId, so every model maps its `id` onto `_id` and every
//     relation scalar carries `@db.ObjectId`.
//   * Scalar lists are unsupported, so `Event.tags` is stored as `Json`.
//   * MongoDB has no SQL migrations. Apply schema changes with
//     `npm run prisma:push` (`prisma db push`), never `prisma migrate`.
//   * `$transaction` requires a replica set; `compose.yaml` starts a single
//     node replica set for local development and tests.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  email                String               @unique
  passwordHash         String
  fullName             String
  phone                String?
  college              String?
  department           String?
  semester             Int?
  year                 Int?
  enrollmentNumber     String?
  emailVerifiedAt      DateTime?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  roles                UserRole[]
  sessions             Session[]
  authTokens           AuthToken[]
  createdEvents        Event[]              @relation("EventCreatedBy")
  registrations        Registration[]       @relation("UserRegistrations")
  proofs               Proof[]
  certificates         Certificate[]
  notificationReceipts NotificationRecipient[]
  auditLogs            AuditLog[]
  verifiedAttendance   Attendance[]         @relation("AttendanceVerifiedBy")
  uploadedFiles        FileRecord[]         @relation("FileUploadedBy")
  uploadedDocuments    EventDocument[]
  teamMemberships      TeamMember[]
  attendanceRecords    Attendance[]         @relation("AttendanceParticipant")

  @@index([enrollmentNumber])
}

model Role {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String           @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  code        String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  roleId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String     @db.ObjectId
  permissionId String     @db.ObjectId
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuthToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([expiresAt])
}

model EventCategory {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String  @unique
  description String?
  events      Event[]
}

model Organizer {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  contactEmail String?
  contactPhone String?
  description  String?
  events       Event[]
  createdAt    DateTime @default(now())
}

model Event {
  id                          String         @id @default(auto()) @map("_id") @db.ObjectId
  title                       String
  slug                        String         @unique
  shortDescription            String
  description                 String
  categoryId                  String?        @db.ObjectId
  organizerId                 String?        @db.ObjectId
  mode                        String         @default("OFFLINE")
  bannerUrl                   String?
  bannerStorageKey            String?
  venueName                   String?
  venueAddress                String?
  city                        String?
  state                       String?
  latitude                    Float?
  longitude                   Float?
  allowedRadiusMeters         Int?
  startAt                     DateTime
  endAt                       DateTime
  registrationStartAt         DateTime
  registrationEndAt           DateTime
  capacity                    Int
  confirmedCount              Int            @default(0)
  registrationType            String         @default("INDIVIDUAL")
  approvalRequired            Boolean        @default(false)
  waitlistEnabled             Boolean        @default(true)
  minTeamSize                 Int?
  maxTeamSize                 Int?
  attendanceEnabled           Boolean        @default(true)
  minimumAttendancePercentage Float          @default(75)
  certificateEnabled          Boolean        @default(true)
  rules                       Json?
  schedule                    Json?
  speakers                    Json?
  prizes                      Json?
  contactDetails              Json?
  // MongoDB has no scalar list type; tags are persisted as a JSON array.
  tags                        Json?
  status                      String         @default("DRAFT")
  createdById                 String         @db.ObjectId
  publishedAt                 DateTime?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  deletedAt                   DateTime?
  category                    EventCategory? @relation(fields: [categoryId], references: [id])
  organizer                   Organizer?     @relation(fields: [organizerId], references: [id])
  createdBy                   User           @relation("EventCreatedBy", fields: [createdById], references: [id])
  documents                   EventDocument[]
  registrations               Registration[]
  teams                       Team[]
  attendances                 Attendance[]
  proofs                      Proof[]
  certificates                Certificate[]

  @@index([status, startAt])
  @@index([categoryId])
  @@index([organizerId])
  @@index([registrationStartAt, registrationEndAt])
}

model EventDocument {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  eventId      String   @db.ObjectId
  name         String
  storageKey   String
  url          String
  mimeType     String
  fileSize     Int
  uploadedById String   @db.ObjectId
  createdAt    DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id])
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@index([eventId])
}

model Registration {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  eventId            String              @db.ObjectId
  userId             String              @db.ObjectId
  registrationNumber String              @unique
  status             String              @default("PENDING")
  customFormAnswers  Json?
  registeredAt       DateTime            @default(now())
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  event              Event               @relation(fields: [eventId], references: [id])
  user               User                @relation("UserRegistrations", fields: [userId], references: [id])
  answers            RegistrationAnswer[]
  ticket             Ticket?
  attendance         Attendance?
  certificates       Certificate[]

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
}

model RegistrationAnswer {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  registrationId String       @db.ObjectId
  fieldKey       String
  value          Json
  registration   Registration @relation(fields: [registrationId], references: [id])

  @@unique([registrationId, fieldKey])
}

model Team {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  eventId    String       @db.ObjectId
  name       String
  leaderId   String       @db.ObjectId
  inviteCode String       @unique
  status     String       @default("FORMING")
  createdAt  DateTime     @default(now())
  event      Event        @relation(fields: [eventId], references: [id])
  members    TeamMember[]

  @@index([eventId, status])
}

model TeamMember {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId   String   @db.ObjectId
  userId   String   @db.ObjectId
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model Ticket {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  registrationId String       @unique @db.ObjectId
  tokenHash      String       @unique
  nonce          String       @unique
  issuedAt       DateTime     @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  status         String       @default("ACTIVE")
  registration   Registration @relation(fields: [registrationId], references: [id])
}

model Attendance {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  eventId              String       @db.ObjectId
  registrationId       String       @unique @db.ObjectId
  userId               String       @db.ObjectId
  checkInAt            DateTime?
  checkOutAt           DateTime?
  attendanceMinutes    Int?
  attendancePercentage Float?
  status               String       @default("NOT_MARKED")
  checkInMethod        String?
  checkOutMethod       String?
  verifiedById         String?      @db.ObjectId
  overrideReason       String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  event                Event        @relation(fields: [eventId], references: [id])
  registration         Registration @relation(fields: [registrationId], references: [id])
  user                 User         @relation("AttendanceParticipant", fields: [userId], references: [id])
  verifiedBy           User?        @relation("AttendanceVerifiedBy", fields: [verifiedById], references: [id])

  @@index([eventId, status])
  @@index([userId])
}

model Proof {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  userId               String   @db.ObjectId
  eventId              String   @db.ObjectId
  type                 String
  storageKey           String
  url                  String
  originalFileName     String
  mimeType             String
  fileSize             Int
  checksum             String
  uploadedAt           DateTime @default(now())
  verificationStatus   String   @default("PENDING")
  verificationScore    Float?
  verificationMetadata Json?
  reviewedById         String?  @db.ObjectId
  reviewedAt           DateTime?
  user                 User     @relation(fields: [userId], references: [id])
  event                Event    @relation(fields: [eventId], references: [id])

  @@index([eventId, verificationStatus])
  @@index([checksum])
}

model Certificate {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  certificateNumber String        @unique
  eventId           String        @db.ObjectId
  userId            String        @db.ObjectId
  registrationId    String?       @db.ObjectId
  storageKey        String
  certificateUrl    String
  verificationToken String        @unique
  issuedAt          DateTime      @default(now())
  revokedAt         DateTime?
  status            String        @default("ISSUED")
  event             Event         @relation(fields: [eventId], references: [id])
  user              User          @relation(fields: [userId], references: [id])
  registration      Registration? @relation(fields: [registrationId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Notification {
  id         String                  @id @default(auto()) @map("_id") @db.ObjectId
  type       String
  title      String
  message    String
  channel    String                  @default("IN_APP")
  eventId    String?                 @db.ObjectId
  createdAt  DateTime                @default(now())
  recipients NotificationRecipient[]

  @@index([createdAt])
}

model NotificationRecipient {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  notificationId String       @db.ObjectId
  userId         String       @db.ObjectId
  readAt         DateTime?
  deliveredAt    DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId      String?  @db.ObjectId
  action       String
  resourceType String
  resourceId   String?
  oldValue     Json?
  newValue     Json?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@index([actorId])
}

model FileRecord {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  objectKey    String   @unique
  url          String
  originalName String
  mimeType     String
  fileSize     Int
  checksum     String
  visibility   String   @default("PRIVATE")
  uploadedById String   @db.ObjectId
  uploadedAt   DateTime @default(now())
  uploadedBy   User     @relation("FileUploadedBy", fields: [uploadedById], references: [id])

  @@index([checksum])
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model SequenceCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}
