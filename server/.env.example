NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://eventhub:eventhub@localhost:5432/event_management?schema=public
JWT_ACCESS_SECRET=replace-with-a-long-development-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-development-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
PUBLIC_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
STORAGE_PROVIDER=local
STORAGE_BUCKET=event-platform
STORAGE_REGION=auto
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.com
PROOF_VERIFICATION_PROVIDER=none
MAX_IMAGE_BYTES=10485760
MAX_DOCUMENT_BYTES=15728640
# Optional one-time production bootstrap. Set both values before running npm run db:seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
